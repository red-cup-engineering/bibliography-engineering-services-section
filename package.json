{
  "name": "@red-cup-engineering/bibliography-engineering-services-section",
  "version": "0.10.0",
  "type": "module",
  "description": "Engineering policy and operations for depth-2 bibliography Markdown carriers and the depth-1 references: maps they reconcile against across a science section's carrier corpus, plus bibliographic-record retrieval (OpenAlex, PubMed, CrossRef) and systematic-review screening of the candidates it surfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/bibliography-engineering-services-section.git"
  },
  "exports": {
    ".": "./src/bibliography-carrier.mjs",
    "./carrier": "./src/bibliography-carrier.mjs",
    "./operations": "./src/bibliography-operations.mjs",
    "./collect": "./src/bibliography-collect.mjs",
    "./reconcile": "./src/bibliography-reconcile.mjs",
    "./bibtex": "./src/bibliography-bibtex.mjs",
    "./citation-text": "./src/citation-text.mjs",
    "./book-record": "./src/book-record.mjs",
    "./reference-check": "./src/reference-check.mjs",
    "./scripts/resolve-doi.mjs": "./scripts/resolve-doi.mjs",
    "./scripts/search-openalex-works.mjs": "./scripts/search-openalex-works.mjs",
    "./scripts/fetch-openalex-work.mjs": "./scripts/fetch-openalex-work.mjs",
    "./scripts/search-pubmed.mjs": "./scripts/search-pubmed.mjs",
    "./scripts/fetch-pubmed-summaries.mjs": "./scripts/fetch-pubmed-summaries.mjs",
    "./csl": "./src/bibliography-csl.mjs",
    "./migration": "./src/bibliography-migration.mjs",
    "./scripts/migrate-reference-records-to-bibliography-records.mjs": "./scripts/migrate-reference-records-to-bibliography-records.mjs",
    "./register": "./src/register.mjs",
    "./source-record": "./src/source-record.mjs",
    "./screening": "./src/reference-screening-csl.mjs",
    "./screening-core": "./src/reference-screening.mjs",
    "./scripts/screen-candidates.mjs": "./scripts/screen-candidates.mjs",
    "./source-witnessed-review-request.schema.json": "./schemas/bibliography/source-witnessed-review-request.schema.json",
    "./watch": "./src/reference-watch.mjs",
    "./scripts/watch-literature.mjs": "./scripts/watch-literature.mjs",
    "./literature-watch-request.schema.json": "./schemas/bibliography/literature-watch-request.schema.json",
    "./benchmark-audit": "./src/labeled-benchmark-audit.mjs",
    "./scripts/reproduce-synergy-identity-audit.mjs": "./scripts/reproduce-synergy-identity-audit.mjs",
    "./synergy-identity-profiles.json": "./research/source-pins/synergy-2026-benchmark-identity-profiles.json",
    "./screening-endpoint-pilot": "./src/screening-endpoint-pilot.mjs",
    "./cohen-screening-pilot-preregistration.json": "./research/source-pins/cohen-2006-text-screening-pilot-preregistration.json"
  },
  "bin": {
    "bibliography": "./apps/bibliography-cli.mjs"
  },
  "files": [
    "apps/",
    "content/",
    "schemas/",
    "src/",
    "scripts/",
    "research/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check src/*.mjs && node --check scripts/*.mjs && node --check apps/*.mjs && node --check schemas/bibliography/*.mjs && node --check test/*.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/computer-code-engineering-services-section": "0.1.2",
    "@red-cup-engineering/computer-data-engineering-services-section": "0.2.0",
    "@red-cup-engineering/csl-json-services-section": "0.2.1",
    "@red-cup-engineering/computer-file-engineering-services-section": "0.4.0",
    "@red-cup-engineering/html-structural-projection-service": "0.3.2",
    "@red-cup-engineering/json-services-section": "0.4.0",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.2",
    "@red-cup-engineering/witness-journal-document-service": "0.1.2",
    "@red-cup-engineering/http-services-section": "0.6.2",
    "@red-cup-engineering/json-schema-services-section": "0.5.0",
    "@red-cup-engineering/javascript-node-operation-service": "0.1.0",
    "@red-cup-engineering/read-markdown-frontmatter-service": "0.2.2",
    "@red-cup-engineering/csv-services-section": "0.1.4"
  },
  "keywords": [
    "bibliography",
    "citation",
    "bibtex",
    "csl-json",
    "openalex",
    "pubmed",
    "crossref",
    "prisma",
    "knowledge-system"
  ],
