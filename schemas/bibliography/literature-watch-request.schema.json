{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/red-cup-engineering/bibliography-engineering-services-section/blob/main/schemas/bibliography/literature-watch-request.schema.json",
  "title": "Bounded on-demand bibliographic literature watch request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "ledger",
    "now"
  ],
  "properties": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lookbackDays",
        "queries"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lookbackDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "query"
            ],
            "properties": {
              "source": {
                "enum": [
                  "openalex",
                  "pubmed"
                ]
              },
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "required": [
        "searches",
        "candidates"
      ],
      "additionalProperties": true,
      "properties": {
        "searches": {
          "type": "array",
          "maxItems": 5000
        },
        "candidates": {
          "type": "array",
          "maxItems": 5000
        }
      }
    },
    "now": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "email": {
      "type": "string",
      "maxLength": 254
    },
    "mailto": {
      "type": "string",
      "maxLength": 254
    }
  }
}
